{
  "name": "dsh-modal-enhancer",
  "version": "1.2.0",
  "private": false,
  "description": "Add drag, eight-way resize, pin, maximize, backdrop controls, and persistent state to DeepSeek Harness web modals.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "lisniuse",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "modal",
    "dialog",
    "draggable",
    "resizable",
    "client"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dist",
    "src",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test scripts/layout-check.test.js",
    "test:syntax": "node scripts/syntax-check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
